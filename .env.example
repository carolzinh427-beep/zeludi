# ===================================================
# ZELUDI PLATFORM — ENVIRONMENT CONFIGURATION
# ===================================================

# Supabase Project URL & Anon Key (Client-safe)
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Optional: Weather API (Open-Meteo is free & no-key needed, but OpenWeather/WeatherAPI can be configured here)
WEATHER_API_KEY=

# Optional: OpenAI / Gemini / Anthropic API Key for Zeludi IA Assistant (Server-only)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
